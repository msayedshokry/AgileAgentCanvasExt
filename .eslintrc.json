{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "@typescript-eslint/no-explicit-any": "warn",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "../webview-ui/src/**",
              "../../webview-ui/src/**",
              "../../../webview-ui/src/**"
            ],
            "message": "Cross-package relative-path imports from webview-ui/src/ are forbidden. They bypass the `exports` gate declared in webview-ui/package.json (Node only enforces exports for by-name imports, not relative paths). Use the by-name workspace import 'bmad-canvas-webview/<subpath>' instead (see the `exports` field in webview-ui/package.json for allowed subpaths)."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "features/**/*.ts", "src/test/**/*.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off"
      }
    },
    {
      "files": ["features/step_definitions/*.steps.ts"],
      "rules": {
        "no-bare-assert": "error",
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-var-requires": "off",
        "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }]
      }
    }
  ]
}
